{
	# Pentest F-RELAY-009: the site's `log { output discard }` below covers
	# only the ACCESS log. Everything else Caddy logs goes to its DEFAULT
	# logger, i.e. stderr and so journald - among it `http.log.error` (client
	# IP + URI of every failed request, e.g. each 502 while the relay
	# restarts) and `http.stdlib` (the peer address of every failed TLS
	# handshake). Discard it too.
	log default {
		output discard
	}
	# ...except certificate upkeep: ACME obtain/renew log the site's own
	# domain and the CA's answer, no client data. Without this a failing
	# renewal would stay silent until the certificate expired.
	log acme {
		output stderr
		include tls.obtain tls.renew
	}
}

138-199-144-35.sslip.io {
	# iOS download bundle for SideStore/AltStore (IPA, checksum, apps.json,
	# icon) — static files only, copied here per release (deploy/README.md,
	# "iOS app downloads"). Never proxied to the relay.
	handle_path /ios/* {
		root * /srv/secure-chat-ios
		file_server
		header {
			Cache-Control "no-cache"
			X-Content-Type-Options "nosniff"
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; form-action 'none'; sandbox"
			-Server
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
	log {
		output discard
	}
}
