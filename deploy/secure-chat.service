[Unit]
Description=secure-chat relay (uvicorn, loopback only)
After=network.target

[Service]
User=securechat
Group=securechat
WorkingDirectory=/opt/secure-chat/backend
# Both front ends reach this ONE process over loopback: Caddy (TLS, clearnet)
# and Tor (onion -> 127.0.0.1:8000). Sharing the process is deliberate — rooms,
# session tokens and login challenges live in memory, so a second instance would
# split-brain them.
Environment=SECURE_CHAT_EXTRA_ORIGINS=https://138-199-144-35.sslip.io,http://626vkwn6znrko2xhorirvv5ttrbzcr3xkdjmk65cks26qkvadplyk5id.onion
# Pentest 2026-07-29 L-8: the DB used to default next to the code, which forced
# ReadWritePaths=/opt/secure-chat/backend and left the relay's own source
# writable to itself. State now lives in its own StateDirectory, so the code
# tree is covered by ProtectSystem=strict with no write exception at all.
# MIGRATION (one-off, before the first restart on this unit):
#   install -d -o securechat -g securechat -m 0700 /var/lib/secure-chat
#   mv /opt/secure-chat/backend/accounts.db* /var/lib/secure-chat/
Environment=SECURE_CHAT_DB=/var/lib/secure-chat/accounts.db
#
# DELIBERATELY ABSENT: SECURE_CHAT_TRUSTED_PROXIES.
# It used to be 127.0.0.1 so per-IP rate limiting worked behind Caddy. Since
# 2026-07-28 Tor also forwards to 127.0.0.1:8000, and the app CANNOT tell a Tor
# visitor from Caddy — both are loopback peers. Trusting loopback would let any
# onion visitor forge X-Forwarded-For and mint a fresh rate-limit bucket per
# request, which is pentest 2026-07-25 F-03 reopened. Unset => accounts.client_key
# trusts nobody and every /api limiter keys on one shared bucket: fails CLOSED.
# DO NOT re-add it while the onion service forwards to this port.
ExecStart=/opt/secure-chat/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --no-server-header --no-proxy-headers --no-access-log --log-level warning --ws-max-size 66560
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
# The only writable path, and there is deliberately no ReadWritePaths for the
# code tree (L-8).
#
# StateDirectoryMode is NOT optional here. systemd defaults it to 0755, so
# without this line /var/lib/secure-chat is world-readable and so is the
# accounts.db inside it (sqlite creates the file 0644): every local user could
# read the directory's lookup TOKENS — the secret half of `username#token`, the
# whole anti-enumeration control — and the sealed mailbox ciphertext. An earlier
# revision of this comment claimed systemd creates it 0700; it does not, and the
# claim was never measured. 0700 is also why the migration below uses 0700:
# systemd enforces this mode on every start, so a directory installed 0750 would
# be silently tightened and the two would disagree.
StateDirectory=secure-chat
StateDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
#
# Second tier (pentest F-RELAY-010, package 5). What the relay does, which is
# all these allow: listen on 127.0.0.1:8000 for Caddy and Tor, read its code
# and the client tree, read and write ONE sqlite file under StateDirectory. It
# makes no outbound connection at all (no HTTP client, no DNS, no SMTP — grep
# backend/*.py), so the network is fenced to loopback in both directions.
# Measured with systemd-run on the dev box (systemd 261, Python 3.13): the
# backend suite (256 tests) and the three client integration suites against a
# real uvicorn (uvloop + httptools + websockets) pass with every line below.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A syscall outside the set fails with EPERM instead of killing the process:
# a surprise in a library update degrades one request, not the whole relay.
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute: CPython 3.13 has no JIT by default, and nothing here
# uses cffi's ABI-mode ffi.callback() (the one cffi feature that needs W+X
# memory; cryptography 49 is Rust + out-of-line cffi, uvloop/httptools are
# plain C). Measured: under MDWE ffi.callback() raises MemoryError while
# Ed25519, ML-DSA-65 and the full relay work. If a future dependency needs
# W+X, it fails loudly at that call — do not "fix" it by dropping this line
# without knowing which call it was.
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
# The accounts DB and its -wal/-shm are created 0600, not 0644 (belt and
# braces under StateDirectoryMode=0700).
UMask=0077
# DELIBERATELY ABSENT: PrivateUsers=yes. It would add little here (the process
# already runs unprivileged with an empty capability set) and it changes how
# /opt/secure-chat/venv's owner appears inside the service; that has not been
# measured on the box, and a unit that fails to start is an outage.

[Install]
WantedBy=multi-user.target
