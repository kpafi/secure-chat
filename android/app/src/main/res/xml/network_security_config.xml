<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted so the relay can be reached over plain HTTP/WS in the
  two cases the browser still allows it from the app's secure (https) page:
    * a LOOPBACK relay (http://127.0.0.1:8000, e.g. `adb reverse` in dev, or a
      local Orbot SOCKS/relay), which Chromium treats as potentially trustworthy;
    * a Tor .onion (also potentially trustworthy; the Tor circuit encrypts it).
  A plain http:// LAN host (192.168.x.x) is NOT one of these — the browser's
  Mixed-Content rule blocks an insecure ws:// from an https page regardless of
  this setting, so such a relay simply will not connect (the app shows a clear
  error). For a clearnet production relay, front it with TLS: the page then uses
  wss:// and no cleartext is involved.
  This does NOT affect chat security either way: all confidentiality/authenticity
  is end-to-end inside the bundled client; the relay only sees opaque ciphertext.
-->
<network-security-config>
    <!-- Default: no cleartext anywhere. A clearnet relay must be https/wss. -->
    <base-config cleartextTrafficPermitted="false" />
    <!-- Cleartext is scoped to exactly the two hosts the browser still treats as
         potentially-trustworthy from the app's secure page: loopback and .onion. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">onion</domain>
    </domain-config>
</network-security-config>
