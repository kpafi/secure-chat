<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The relay is remote; the app needs the network. No other permissions:
         crypto, identity storage (WebView localStorage) and UI are all local.
         Handing a pad file out (share sheet, system save dialog) and picking
         one to import (system document picker) need none either: the Storage
         Access Framework and a FileProvider grant work per document, on the
         user's pick. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SecureChat">

        <!-- Package 6, F-P7-24: no SafeBrowsing. It sends URL hash prefixes of
             every load to Google; this WebView loads only the bundled client
             and the one configured relay, so it protects nothing here and
             would tell a third party when and where the app connects. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <!-- Package 3, F-ANDROID-001: taskAffinity="" so no other app can
             declare OUR affinity and have its activity placed into this task
             (the StrandHogg-style overlay: a lookalike screen asking for the
             passphrase, sitting in secure-chat's own task and recents card).
             launchMode stays the default (standard): a launcher tap still finds
             and resumes the existing task, which Android matches by the root
             activity's component when the task has no affinity. -->
        <!-- configChanges (OTP transfer sheets fix round 2, cold critic mi-5):
             every configuration change this single-WebView activity can take
             in place. Recreating it RELOADS THE PAGE: the unlocked identity,
             live chats and a pad file waiting in the export sheet are gone
             (the pad is already latched as exported), and a save dialog open
             at that moment answers into nothing. Nothing here is
             layout-inflated per configuration (no -night/-land/-sw
             resources; the page does its own layout), so taking the change in
             place costs only: the native bar's strings and theme follow a
             locale or dark-mode switch at the next start. What still reloads
             the page: process death (the system reclaiming memory while the
             share sheet or save dialog is in front) - see android/README.md. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|touchscreen|uiMode|locale|layoutDirection|fontScale|colorMode|mcc|mnc|grammaticalGender">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OTP transfer sheets: the exported pad file handed to the share
             sheet. Not exported: nothing can open a URI of ours except a
             target the chooser grants read access to, one file at a time.
             The paths xml exposes cacheDir/pad-share/ and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pad_share_paths" />
        </provider>
    </application>
</manifest>
