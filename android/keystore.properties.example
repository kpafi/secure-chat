# Copy to keystore.properties (gitignored) and fill in real values to enable
# signed release builds. Without this file, `assembleRelease` still works but
# produces an UNSIGNED apk (fine for local testing, not for distribution).
#
# Generate a keystore:
#   keytool -genkeypair -v -keystore release.keystore -alias secure-chat-release \
#     -keyalg RSA -keysize 4096 -validity 10000
# Note: modern (PKCS12) keystores use ONE password for both store and key —
# keyPassword must equal storePassword or keytool silently ignores -keypass.
storeFile=release.keystore
storePassword=changeme
keyAlias=secure-chat-release
keyPassword=changeme
