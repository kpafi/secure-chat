{
  "name": "lean-qr",
  "version": "2.7.2",
  "description": "minimal QR code generation",
  "bin": "./cli.mjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./index.mjs",
      "types": "./index.d.ts"
    },
    "./nano": {
      "require": "./nano.mjs",
      "import": "./nano.mjs",
      "types": "./index.d.ts"
    },
    "./extras/svg": {
      "require": "./extras/svg.js",
      "import": "./extras/svg.mjs",
      "types": "./index.d.ts"
    },
    "./extras/node_export": {
      "require": "./extras/node_export.js",
      "import": "./extras/node_export.mjs",
      "types": "./index.d.ts"
    },
    "./extras/react": {
      "require": "./extras/react.js",
      "import": "./extras/react.mjs",
      "types": "./index.d.ts"
    },
    "./extras/vue": {
      "require": "./extras/vue.js",
      "import": "./extras/vue.mjs",
      "types": "./index.d.ts"
    },
    "./webcomponent": {
      "require": "./webcomponent.mjs",
      "import": "./webcomponent.mjs",
      "types": "./webcomponent.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidje13/lean-qr.git"
  },
  "keywords": [
    "qr",
    "qr-code",
    "qrcode",
    "barcode",
    "react",
    "react-component",
    "preact",
    "preact-component",
    "vue",
    "vue-component",
    "web-component",
    "console",
    "terminal"
  ],
  "author": "David Evans",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/davidje13/lean-qr/issues"
  },
  "homepage": "https://github.com/davidje13/lean-qr#readme"
}